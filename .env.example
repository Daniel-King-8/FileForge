# 复制为 .env 后按需修改；scripts/deploy.sh 会自动补齐密钥与 DOCKER_GID
# 生成随机值：openssl rand -hex 32

SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@fileforge.local
ADMIN_PASSWORD=

# Linux 上通常是 docker 组 gid（stat -c '%g' /var/run/docker.sock）
DOCKER_GID=0

HTTP_PORT=80
# auto=Linux 启用 libmagic、其他平台用内置魔数；也可设 on/off
LIBMAGIC=auto
TZ=Asia/Shanghai
DISPLAY_TZ=Asia/Shanghai

MAX_UPLOAD_MB=200
USER_QUOTA_MB=2048
RESULT_TTL_HOURS=24
MAX_CONCURRENT=2

# subpath：每个转换容器只挂载自己任务的临时目录（推荐，Docker 25+）
# volume： 挂载整个 tmp 卷（旧版 Docker 的兼容模式）
TOOL_MOUNT=subpath
FFMPEG_IMAGE=fileforge/media-tools:1.0.0
OFFICE_IMAGE=fileforge/office-tools:1.0.0
ARCHIVE_IMAGE=fileforge/media-tools:1.0.0

# 若通过 HTTPS 反向代理访问，改为 1
SECURE_COOKIES=0
